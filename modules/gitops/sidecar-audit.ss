;;; -*- Gerbil -*-
;;; SPDX-FileCopyrightText: 2026 tao3k team and Contributors
;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later

;;; RFC 0022 + RFC 0023: Native Scheme/POO gerbil-ascent engine for Detached
;;; Sidecar AI Audit obligation derivation, Deterministic Engineering formal
;;; library reuse (`upstream-library-reuse`) + project-specific ephemeral AI
;;; overlays (`ephemeral-ai-overlay` with mandatory MR05 @countermodel),
;;; G2 mechanical diff-delta defects, F3 Quint guard-probe, N-Version
;;; dual-oracle disagreement fail-closed, dual-mode sanctioned AI engine
;;; directives (`native-ai-environment` + `marlin-agent-core`), and NASA
;;; NPR 7150.2D (`SWE-083`, `SWE-084`, `SWE-087`, `SWE-146`) admission.
;;; Never grants execution authority (`action-authorized?: #f`).

(import (only-in :clan/poo/object .o .get .ref .slot? object?)
        (only-in :gerbil/core string-prefix?)
        (only-in :std/list/list append-map delete-duplicates/hash filter-map)
        (only-in :gerbil-ascent/program/api
                 relational-fragment relational-export relational-compose
                 relational-open-session relational-session-prepare-transaction
                 relational-prepare-queries))
(export gitops-sidecar-audit-assess)

(def +sanctioned-ai-engines+ '("native-ai-environment" "marlin-agent-core"))
(def +nasa-sidecar-obligations+ '("SWE-083" "SWE-084" "SWE-087" "SWE-146"))
(def +formal-model-modes+ '("upstream-library-reuse" "ephemeral-ai-overlay"))

(def +sidecar-audit-engine-mutex+ (make-mutex 'sidecar-audit-engine))
(def +sidecar-audit-engine-cell+ (box #f))

(def (opt-slot obj key default)
  (if (and (object? obj) (.slot? obj key))
    (.ref obj key)
    default))

(def (make-sidecar-audit-engine)
  (let* ((intake-frag
          (relational-fragment
           (import)
           (source (required_lens (lens) '() (role input))
                   (covered_lens (lens) '() (role input))
                   (polluted_path (path) '() (role input))
                   (report_engine (report_id engine) '() (role input))
                   (allowed_engine (engine) '() (role input)))
           (private (missing_lens (lens))
                    (disallowed_engine (report_id engine)))
           (export (required_lens required_lens)
                   (covered_lens covered_lens)
                   (polluted_path polluted_path)
                   (report_engine report_engine)
                   (allowed_engine allowed_engine)
                   (missing_lens missing_lens)
                   (disallowed_engine disallowed_engine))
           (rule (missing_lens ?l)
                 (required_lens ?l)
                 (not (covered_lens ?l)))
           (rule (disallowed_engine ?r ?e)
                 (report_engine ?r ?e)
                 (not (allowed_engine ?e)))))
         (review-frag
          (relational-fragment
           (import)
           (source (high_finding (finding_id) '() (role input))
                   (addressed_finding (finding_id) '() (role input))
                   (stale_report (report_id) '() (role input))
                   (missing_provenance (report_id) '() (role input))
                   (fact_flag (name) '() (role input))
                   (required_flag (name) '() (role input)))
           (private (unaddressed_high (finding_id))
                    (missing_flag (name)))
           (export (high_finding high_finding)
                   (addressed_finding addressed_finding)
                   (stale_report stale_report)
                   (missing_provenance missing_provenance)
                   (fact_flag fact_flag)
                   (required_flag required_flag)
                   (unaddressed_high unaddressed_high)
                   (missing_flag missing_flag))
           (rule (unaddressed_high ?f)
                 (high_finding ?f)
                 (not (addressed_finding ?f)))
           (rule (missing_flag ?n)
                 (required_flag ?n)
                 (not (fact_flag ?n)))))
         (formal-oracle-frag
          (relational-fragment
           (import)
           (source (g2_defect (finding_id) '() (role input))
                   (redundant_guard_probe (probe_id) '() (role input))
                   (formal_model (model_id mode) '() (role input))
                   (allowed_model_mode (mode) '() (role input))
                   (ephemeral_mode_tag (mode) '() (role input))
                   (model_resolver_ok (model_id) '() (role input))
                   (model_countermodel_ok (model_id) '() (role input))
                   (model_proof_clean (model_id) '() (role input))
                   (model_check_passed (model_id) '() (role input))
                   (model_vault_isolated (model_id) '() (role input))
                   (pending_oracle (oracle_id) '() (role input))
                   (coordinator_admit_claim (claim_id) '() (role input)))
           (private (invalid_model_mode (model_id mode))
                    (unresolved_formal_model (model_id))
                    (vacuous_ephemeral_overlay (model_id))
                    (polluting_ephemeral_overlay (model_id))
                    (unclean_formal_proof (model_id))
                    (failed_formal_model (model_id))
                    (admitted_formal_model (model_id mode)))
           (export (g2_defect g2_defect)
                   (redundant_guard_probe redundant_guard_probe)
                   (formal_model formal_model)
                   (allowed_model_mode allowed_model_mode)
                   (ephemeral_mode_tag ephemeral_mode_tag)
                   (model_resolver_ok model_resolver_ok)
                   (model_countermodel_ok model_countermodel_ok)
                   (model_proof_clean model_proof_clean)
                   (model_check_passed model_check_passed)
                   (model_vault_isolated model_vault_isolated)
                   (pending_oracle pending_oracle)
                   (coordinator_admit_claim coordinator_admit_claim)
                   (invalid_model_mode invalid_model_mode)
                   (unresolved_formal_model unresolved_formal_model)
                   (vacuous_ephemeral_overlay vacuous_ephemeral_overlay)
                   (polluting_ephemeral_overlay polluting_ephemeral_overlay)
                   (unclean_formal_proof unclean_formal_proof)
                   (failed_formal_model failed_formal_model)
                   (admitted_formal_model admitted_formal_model))
           (rule (invalid_model_mode ?m ?mode)
                 (formal_model ?m ?mode)
                 (not (allowed_model_mode ?mode)))
           (rule (unresolved_formal_model ?m)
                 (formal_model ?m ?_)
                 (not (model_resolver_ok ?m)))
           (rule (vacuous_ephemeral_overlay ?m)
                 (formal_model ?m ?mode)
                 (ephemeral_mode_tag ?mode)
                 (not (model_countermodel_ok ?m)))
           (rule (polluting_ephemeral_overlay ?m)
                 (formal_model ?m ?mode)
                 (ephemeral_mode_tag ?mode)
                 (not (model_vault_isolated ?m)))
           (rule (unclean_formal_proof ?m)
                 (formal_model ?m ?_)
                 (not (model_proof_clean ?m)))
           (rule (failed_formal_model ?m)
                 (formal_model ?m ?_)
                 (not (model_check_passed ?m)))
           (rule (admitted_formal_model ?m ?mode)
                 (formal_model ?m ?mode)
                 (allowed_model_mode ?mode)
                 (model_resolver_ok ?m)
                 (model_proof_clean ?m)
                 (model_check_passed ?m)
                 (not (vacuous_ephemeral_overlay ?m))
                 (not (polluting_ephemeral_overlay ?m)))))
         (obligation-frag
          (relational-fragment
           (import (polluted_path (relational-export intake-frag 'polluted_path))
                   (missing_lens (relational-export intake-frag 'missing_lens))
                   (disallowed_engine (relational-export intake-frag 'disallowed_engine))
                   (unaddressed_high (relational-export review-frag 'unaddressed_high))
                   (stale_report (relational-export review-frag 'stale_report))
                   (missing_provenance (relational-export review-frag 'missing_provenance))
                   (missing_flag (relational-export review-frag 'missing_flag))
                   (g2_defect (relational-export formal-oracle-frag 'g2_defect))
                   (redundant_guard_probe (relational-export formal-oracle-frag 'redundant_guard_probe))
                   (invalid_model_mode (relational-export formal-oracle-frag 'invalid_model_mode))
                   (unresolved_formal_model (relational-export formal-oracle-frag 'unresolved_formal_model))
                   (vacuous_ephemeral_overlay (relational-export formal-oracle-frag 'vacuous_ephemeral_overlay))
                   (polluting_ephemeral_overlay (relational-export formal-oracle-frag 'polluting_ephemeral_overlay))
                   (unclean_formal_proof (relational-export formal-oracle-frag 'unclean_formal_proof))
                   (failed_formal_model (relational-export formal-oracle-frag 'failed_formal_model))
                   (pending_oracle (relational-export formal-oracle-frag 'pending_oracle))
                   (coordinator_admit_claim (relational-export formal-oracle-frag 'coordinator_admit_claim)))
           (source (obligation (id) '() (role input))
                   (swe083_tag (id) '() (role input))
                   (swe084_tag (id) '() (role input))
                   (swe087_tag (id) '() (role input))
                   (swe146_tag (id) '() (role input))
                   (human_flag_tag (name) '() (role input))
                   (conv_flag_tag (name) '() (role input)))
           (private (base_blocker (reason))
                    (oracle_disagreement (reason))
                    (blocker (reason))
                    (open_obligation (id))
                    (supported_obligation (id)))
           (export (obligation obligation)
                   (swe083_tag swe083_tag)
                   (swe084_tag swe084_tag)
                   (swe087_tag swe087_tag)
                   (swe146_tag swe146_tag)
                   (human_flag_tag human_flag_tag)
                   (conv_flag_tag conv_flag_tag)
                   (oracle_disagreement oracle_disagreement)
                   (blocker blocker)
                   (open_obligation open_obligation)
                   (supported_obligation supported_obligation))
           (rule (base_blocker (value 'upstream-pollution))
                 (polluted_path ?_))
           (rule (base_blocker (value 'missing-audit-lens))
                 (missing_lens ?_))
           (rule (base_blocker (value 'unsanctioned-engine-binding))
                 (disallowed_engine ?_ ?_))
           (rule (base_blocker (value 'unaddressed-high-finding))
                 (unaddressed_high ?_))
           (rule (base_blocker (value 'stale-ai-audit))
                 (stale_report ?_))
           (rule (base_blocker (value 'missing-swe146-provenance))
                 (missing_provenance ?_))
           (rule (base_blocker (value 'missing-conversation-binding))
                 (missing_flag ?f)
                 (conv_flag_tag ?f))
           (rule (base_blocker (value 'missing-human-approval))
                 (missing_flag ?f)
                 (human_flag_tag ?f))
           ;; RFC 0023 Deterministic Engineering mechanical oracle & formal library blockers
           (rule (base_blocker (value 'de-g2-mechanical-defect))
                 (g2_defect ?_))
           (rule (base_blocker (value 'de-redundant-guard-probe))
                 (redundant_guard_probe ?_))
           (rule (base_blocker (value 'de-invalid-formal-model-mode))
                 (invalid_model_mode ?_ ?_))
           (rule (base_blocker (value 'de-unresolved-formal-library))
                 (unresolved_formal_model ?_))
           (rule (base_blocker (value 'de-vacuous-ephemeral-overlay))
                 (vacuous_ephemeral_overlay ?_))
           (rule (base_blocker (value 'de-polluting-ephemeral-overlay))
                 (polluting_ephemeral_overlay ?_))
           (rule (base_blocker (value 'de-unclean-formal-proof))
                 (unclean_formal_proof ?_))
           (rule (base_blocker (value 'de-failed-formal-model))
                 (failed_formal_model ?_))
           (rule (base_blocker (value 'de-pending-mechanical-oracle))
                 (pending_oracle ?_))
           ;; N-Version dual-oracle disagreement (imperative coordinator claims ADMIT despite ASCENT blockers)
           (rule (oracle_disagreement (value 'oracle-disagreement-fail-closed))
                 (coordinator_admit_claim ?_)
                 (base_blocker ?_))
           (rule (blocker ?r) (base_blocker ?r))
           (rule (blocker ?r) (oracle_disagreement ?r))
           ;; NASA NPR 7150.2D obligation linkage
           (rule (open_obligation ?o)
                 (swe083_tag ?o)
                 (g2_defect ?_))
           (rule (open_obligation ?o)
                 (swe083_tag ?o)
                 (redundant_guard_probe ?_))
           (rule (open_obligation ?o)
                 (swe083_tag ?o)
                 (failed_formal_model ?_))
           (rule (open_obligation ?o)
                 (swe084_tag ?o)
                 (polluted_path ?_))
           (rule (open_obligation ?o)
                 (swe084_tag ?o)
                 (invalid_model_mode ?_ ?_))
           (rule (open_obligation ?o)
                 (swe084_tag ?o)
                 (unresolved_formal_model ?_))
           (rule (open_obligation ?o)
                 (swe084_tag ?o)
                 (vacuous_ephemeral_overlay ?_))
           (rule (open_obligation ?o)
                 (swe084_tag ?o)
                 (polluting_ephemeral_overlay ?_))
           (rule (open_obligation ?o)
                 (swe084_tag ?o)
                 (unclean_formal_proof ?_))
           (rule (open_obligation ?o)
                 (swe084_tag ?o)
                 (pending_oracle ?_))
           (rule (open_obligation ?o)
                 (swe084_tag ?o)
                 (oracle_disagreement ?_))
           (rule (open_obligation ?o)
                 (swe087_tag ?o)
                 (unaddressed_high ?_))
           (rule (open_obligation ?o)
                 (swe087_tag ?o)
                 (g2_defect ?_))
           (rule (open_obligation ?o)
                 (swe087_tag ?o)
                 (missing_flag ?f)
                 (human_flag_tag ?f))
           (rule (open_obligation ?o)
                 (swe146_tag ?o)
                 (missing_lens ?_))
           (rule (open_obligation ?o)
                 (swe146_tag ?o)
                 (disallowed_engine ?_ ?_))
           (rule (open_obligation ?o)
                 (swe146_tag ?o)
                 (stale_report ?_))
           (rule (open_obligation ?o)
                 (swe146_tag ?o)
                 (missing_provenance ?_))
           (rule (open_obligation ?o)
                 (swe146_tag ?o)
                 (vacuous_ephemeral_overlay ?_))
           (rule (open_obligation ?o)
                 (swe146_tag ?o)
                 (missing_flag ?f)
                 (conv_flag_tag ?f))
           (rule (supported_obligation ?o)
                 (obligation ?o)
                 (not (open_obligation ?o)))))
         (composed (relational-compose (list intake-frag review-frag formal-oracle-frag obligation-frag)
                                       4096 16384 16384))
         (session (relational-open-session composed))
         (run-tx
          (relational-session-prepare-transaction
           session
           (list (list intake-frag 'required_lens)
                 (list intake-frag 'covered_lens)
                 (list intake-frag 'polluted_path)
                 (list intake-frag 'report_engine)
                 (list intake-frag 'allowed_engine)
                 (list review-frag 'high_finding)
                 (list review-frag 'addressed_finding)
                 (list review-frag 'stale_report)
                 (list review-frag 'missing_provenance)
                 (list review-frag 'fact_flag)
                 (list review-frag 'required_flag)
                 (list formal-oracle-frag 'g2_defect)
                 (list formal-oracle-frag 'redundant_guard_probe)
                 (list formal-oracle-frag 'formal_model)
                 (list formal-oracle-frag 'allowed_model_mode)
                 (list formal-oracle-frag 'ephemeral_mode_tag)
                 (list formal-oracle-frag 'model_resolver_ok)
                 (list formal-oracle-frag 'model_countermodel_ok)
                 (list formal-oracle-frag 'model_proof_clean)
                 (list formal-oracle-frag 'model_check_passed)
                 (list formal-oracle-frag 'model_vault_isolated)
                 (list formal-oracle-frag 'pending_oracle)
                 (list formal-oracle-frag 'coordinator_admit_claim)
                 (list obligation-frag 'obligation)
                 (list obligation-frag 'swe083_tag)
                 (list obligation-frag 'swe084_tag)
                 (list obligation-frag 'swe087_tag)
                 (list obligation-frag 'swe146_tag)
                 (list obligation-frag 'human_flag_tag)
                 (list obligation-frag 'conv_flag_tag))))
         (read-intake
          (relational-prepare-queries intake-frag '(polluted_path missing_lens disallowed_engine)))
         (read-review
          (relational-prepare-queries review-frag '(unaddressed_high)))
         (read-formal
          (relational-prepare-queries
           formal-oracle-frag
           '(g2_defect redundant_guard_probe unresolved_formal_model vacuous_ephemeral_overlay
             polluting_ephemeral_overlay unclean_formal_proof failed_formal_model
             pending_oracle admitted_formal_model)))
         (read-obligation
          (relational-prepare-queries
           obligation-frag
           '(blocker open_obligation supported_obligation oracle_disagreement))))
    (.o (run-tx := run-tx)
        (read-intake := read-intake)
        (read-review := read-review)
        (read-formal := read-formal)
        (read-obligation := read-obligation))))

(def (sidecar-audit-engine!)
  (or (unbox +sidecar-audit-engine-cell+)
      (let ((engine (make-sidecar-audit-engine)))
        (set-box! +sidecar-audit-engine-cell+ engine)
        engine)))

(def (non-empty-string? x)
  (and (string? x) (> (string-length x) 0)))

(def (sha256-digest? x)
  (and (string? x) (string-prefix? "sha256:" x) (> (string-length x) 7)))

(def (polluted-path? path forbidden-prefixes)
  (and (string? path)
       (ormap (lambda (prefix) (string-prefix? prefix path)) forbidden-prefixes)))

;;; Pure POO entry point for Scheme/ASCENT detached sidecar audit derivation.
;;; `input` is a POO object carrying RFC 0022 slots plus optional RFC 0023 slots:
;;;   g2-findings, guard-probes, formal-models, pending-oracles, coordinator-claimed-admit?.
(def (gitops-sidecar-audit-assess input)
  (let* ((target-repo (opt-slot input 'target-repo "unknown-repo"))
         (nasa-profile (opt-slot input 'nasa-profile "nasa/sdlc/npr-7150.2d"))
         (context-digest (opt-slot input 'context-digest ""))
         (changed-paths (opt-slot input 'changed-paths '()))
         (forbidden-prefixes (opt-slot input 'forbidden-prefixes '(".agents/aita/" ".aitia/")))
         (required-lenses (delete-duplicates/hash (opt-slot input 'required-lenses '())))
         (ai-reports (opt-slot input 'ai-reports '()))
         (conversation-bound? (and (opt-slot input 'conversation-bound? #f) #t))
         (human-approved? (and (opt-slot input 'human-approved? #f) #t))
         (dispositions (opt-slot input 'dispositions '()))
         ;; RFC 0023 optional DE mechanical oracle & formal library inputs
         (g2-findings (opt-slot input 'g2-findings '()))
         (guard-probes (opt-slot input 'guard-probes '()))
         (formal-models (opt-slot input 'formal-models '()))
         (pending-oracles (opt-slot input 'pending-oracles '()))
         (coordinator-claimed-admit? (and (opt-slot input 'coordinator-claimed-admit? #f) #t))
         (polluted-paths
          (filter (lambda (p) (polluted-path? p forbidden-prefixes)) changed-paths))
         (report-entries
          (map (lambda (rep idx)
                 (let* ((rid (string-append "report-" (number->string idx)))
                        (engine (opt-slot rep 'engine-binding ""))
                        (lens (opt-slot rep 'lens ""))
                        (rep-ctx (opt-slot rep 'context-digest ""))
                        (epistemic (opt-slot rep 'epistemic-status ""))
                        (auth? (opt-slot rep 'action-authorized? #t))
                        (prov-ok?
                         (and (non-empty-string? (opt-slot rep 'provider ""))
                              (non-empty-string? (opt-slot rep 'model-id ""))
                              (sha256-digest? (opt-slot rep 'prompt-template-digest ""))
                              (equal? epistemic "hypothesized")
                              (not auth?)))
                        (stale? (not (equal? rep-ctx context-digest)))
                        (high-ids
                         (filter-map
                          (lambda (f)
                            (let ((sev (opt-slot f 'severity ""))
                                  (fid (opt-slot f 'id "")))
                              (and (or (equal? sev "critical") (equal? sev "high"))
                                   (non-empty-string? fid)
                                   fid)))
                          (opt-slot rep 'findings '()))))
                   (.o (rid := rid) (engine := engine) (lens := lens)
                       (prov-ok? := prov-ok?) (stale? := stale?) (high-ids := high-ids))))
               ai-reports (iota (length ai-reports))))
         (covered-lenses
          (delete-duplicates/hash
           (filter-map (lambda (e)
                         (and (non-empty-string? (.get e lens))
                              (member (.get e engine) +sanctioned-ai-engines+)
                              (not (.get e stale?))
                              (.get e prov-ok?)
                              (.get e lens)))
                       report-entries)))
         (report-engine-rows
          (map (lambda (e) (list (.get e rid) (.get e engine))) report-entries))
         (stale-rows
          (filter-map (lambda (e) (and (.get e stale?) (list (.get e rid)))) report-entries))
         (missing-prov-rows
          (filter-map (lambda (e) (and (not (.get e prov-ok?)) (list (.get e rid)))) report-entries))
         (high-finding-rows
          (map list (delete-duplicates/hash (append-map (lambda (e) (.get e high-ids)) report-entries))))
         (addressed-rows
          (map list
               (delete-duplicates/hash
                (filter-map
                 (lambda (d)
                   (let ((fid (opt-slot d 'finding-id ""))
                         (status (opt-slot d 'status ""))
                         (rationale (opt-slot d 'rationale "")))
                     (and (non-empty-string? fid)
                          (or (equal? status "fixed-verified")
                              (equal? status "waived-with-rationale"))
                          (non-empty-string? rationale)
                          fid)))
                 dispositions))))
         (fact-flag-rows
          (append (if conversation-bound? '(("conversation-bound")) '())
                  (if human-approved? '(("human-approved")) '())))
         ;; RFC 0023 relational fact projection
         (g2-defect-rows
          (map list
               (delete-duplicates/hash
                (filter-map
                 (lambda (g)
                   (let ((gid (opt-slot g 'id ""))
                         (rule (opt-slot g 'rule ""))
                         (hclass (opt-slot g 'hallucination-class "")))
                     (and (or (non-empty-string? gid) (non-empty-string? rule))
                          (string-append (if (non-empty-string? hclass) hclass "g2-defect")
                                         ":"
                                         (if (non-empty-string? gid) gid rule)))))
                 g2-findings))))
         (redundant-probe-rows
          (map list
               (delete-duplicates/hash
                (filter-map
                 (lambda (p)
                   (let ((pid (opt-slot p 'probe-id ""))
                         (verdict (opt-slot p 'verdict "")))
                     (and (non-empty-string? pid)
                          (not (equal? verdict "essential"))
                          pid)))
                 guard-probes))))
         (formal-entries
          (map (lambda (m idx)
                 (let* ((mid (let ((raw (opt-slot m 'model-id "")))
                               (if (non-empty-string? raw) raw
                                   (string-append "formal-model-" (number->string idx)))))
                        (mode (opt-slot m 'mode ""))
                        (lib-pkg (opt-slot m 'library-package ""))
                        (res-digest (opt-slot m 'resolver-digest ""))
                        (m-ctx (opt-slot m 'context-digest context-digest))
                        (resolver-ok?
                         (and (non-empty-string? lib-pkg)
                              (sha256-digest? res-digest)))
                        (cm-ok? (and (opt-slot m 'countermodel-verified? #f) #t))
                        (clean? (and (opt-slot m 'proof-clean? #f) #t))
                        (passed? (and (opt-slot m 'passed? #f)
                                      (equal? m-ctx context-digest)
                                      #t))
                        (vault-ok? (and (opt-slot m 'stored-in-sidecar-vault? #f) #t)))
                   (.o (mid := mid) (mode := mode)
                       (resolver-ok? := resolver-ok?) (cm-ok? := cm-ok?)
                       (clean? := clean?) (passed? := passed?) (vault-ok? := vault-ok?))))
               formal-models (iota (length formal-models))))
         (formal-model-rows
          (map (lambda (e) (list (.get e mid) (.get e mode))) formal-entries))
         (model-resolver-rows
          (filter-map (lambda (e) (and (.get e resolver-ok?) (list (.get e mid)))) formal-entries))
         (model-cm-rows
          (filter-map (lambda (e) (and (.get e cm-ok?) (list (.get e mid)))) formal-entries))
         (model-clean-rows
          (filter-map (lambda (e) (and (.get e clean?) (list (.get e mid)))) formal-entries))
         (model-passed-rows
          (filter-map (lambda (e) (and (.get e passed?) (list (.get e mid)))) formal-entries))
         (model-vault-rows
          (filter-map (lambda (e) (and (.get e vault-ok?) (list (.get e mid)))) formal-entries))
         (pending-oracle-rows
          (map list (delete-duplicates/hash (filter non-empty-string? pending-oracles))))
         (coordinator-claim-rows
          (if coordinator-claimed-admit? '(("coordinator-admit")) '()))
         (val->id (make-hash-table))
         (id->val (make-hash-table))
         (next-id 1)
         (intern! (lambda (v)
                    (or (hash-get val->id v)
                        (let ((id next-id))
                          (set! next-id (+ next-id 1))
                          (hash-put! val->id v id)
                          (hash-put! id->val id v)
                          id))))
         (decode (lambda (id) (hash-ref id->val id)))
         (intern-rows (lambda (rows) (map (lambda (row) (map intern! row)) rows)))
         (tx-batches
          (list (intern-rows (map list required-lenses))
                (intern-rows (map list covered-lenses))
                (intern-rows (map list polluted-paths))
                (intern-rows report-engine-rows)
                (intern-rows (map list +sanctioned-ai-engines+))
                (intern-rows high-finding-rows)
                (intern-rows addressed-rows)
                (intern-rows stale-rows)
                (intern-rows missing-prov-rows)
                (intern-rows fact-flag-rows)
                (intern-rows '(("conversation-bound") ("human-approved")))
                (intern-rows g2-defect-rows)
                (intern-rows redundant-probe-rows)
                (intern-rows formal-model-rows)
                (intern-rows (map list +formal-model-modes+))
                (intern-rows '(("ephemeral-ai-overlay")))
                (intern-rows model-resolver-rows)
                (intern-rows model-cm-rows)
                (intern-rows model-clean-rows)
                (intern-rows model-passed-rows)
                (intern-rows model-vault-rows)
                (intern-rows pending-oracle-rows)
                (intern-rows coordinator-claim-rows)
                (intern-rows (map list +nasa-sidecar-obligations+))
                (intern-rows '(("SWE-083")))
                (intern-rows '(("SWE-084")))
                (intern-rows '(("SWE-087")))
                (intern-rows '(("SWE-146")))
                (intern-rows '(("human-approved")))
                (intern-rows '(("conversation-bound")))))
         (query-results
          (dynamic-wind
            (lambda () (mutex-lock! +sidecar-audit-engine-mutex+))
            (lambda ()
              (let* ((eng (sidecar-audit-engine!))
                     (solution ((.get eng run-tx) tx-batches)))
                (list ((.get eng read-intake) solution)
                      ((.get eng read-review) solution)
                      ((.get eng read-formal) solution)
                      ((.get eng read-obligation) solution))))
            (lambda () (mutex-unlock! +sidecar-audit-engine-mutex+))))
         (intake-out (list-ref query-results 0))
         (review-out (list-ref query-results 1))
         (formal-out (list-ref query-results 2))
         (ob-out (list-ref query-results 3))
         (polluted-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref intake-out 0))))
         (missing-lens-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref intake-out 1))))
         (disallowed-out (map (lambda (r) (list (decode (car r)) (decode (cadr r)))) (list-ref intake-out 2)))
         (unaddressed-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref review-out 0))))
         (g2-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref formal-out 0))))
         (redundant-probe-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref formal-out 1))))
         (unresolved-models-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref formal-out 2))))
         (vacuous-overlays-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref formal-out 3))))
         (polluting-overlays-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref formal-out 4))))
         (unclean-proofs-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref formal-out 5))))
         (failed-models-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref formal-out 6))))
         (pending-oracles-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref formal-out 7))))
         (admitted-models-out
          (list-sort (lambda (a b) (string<? (car a) (car b)))
                     (map (lambda (r) (list (decode (car r)) (decode (cadr r)))) (list-ref formal-out 8))))
         (blockers-out (list-sort string<? (map (lambda (r) (symbol->string (car r))) (list-ref ob-out 0))))
         (open-obs-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref ob-out 1))))
         (supported-obs-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref ob-out 2))))
         (oracle-disagreement? (pair? (list-ref ob-out 3)))
         (admissible? (null? blockers-out))
         (epistemic-status
          (cond
           (admissible? "Proven")
           ((and (pair? pending-oracles-out)
                 (equal? blockers-out '("de-pending-mechanical-oracle")))
            "PendingMethod")
           (else "Refuted")))
         (formal-library-guidance
          (.o (general-case-mode := "upstream-library-reuse")
              (special-case-mode := "ephemeral-ai-overlay")
              (quint-library := "@deterministic-engineering/quint-models")
              (quint-resolver := "@deterministic-engineering/quint-modules-resolver")
              (lean-library := "@deterministic-engineering/lean-models")
              (ephemeral-requires-countermodel? := #t)
              (ephemeral-sidecar-only? := #t)))
         (next-handoff
          (cond
           (admissible? "ready-for-sidecar-commit")
           ((pair? polluted-out) "clean-upstream-pollution")
           ((pair? polluting-overlays-out) "clean-upstream-pollution")
           (oracle-disagreement? "resolve-n-version-oracle-disagreement")
           ((pair? pending-oracles-out) "run-pending-mechanical-oracles")
           ((or (pair? g2-out) (pair? redundant-probe-out) (pair? vacuous-overlays-out)
                (pair? unresolved-models-out) (pair? unclean-proofs-out) (pair? failed-models-out))
            "repair-formal-and-mechanical-defects")
           ((or (pair? missing-lens-out) (pair? disallowed-out) (pair? stale-rows) (pair? missing-prov-rows))
            "dispatch-ai-audit-lenses")
           (else "human-independent-review")))
         (funflow-trace
          (.o (schema := "lambda-aitia.funflow-ascent-trace.v1")
              (fragments := '("intake-frag" "review-frag" "formal-oracle-frag" "obligation-frag"))
              (context-digest := context-digest)
              (epistemic-status := epistemic-status)
              (next-frontier := next-handoff)
              (input-counts := (.o (changed-paths := (length changed-paths))
                                   (required-lenses := (length required-lenses))
                                   (ai-reports := (length ai-reports))
                                   (g2-findings := (length g2-findings))
                                   (guard-probes := (length guard-probes))
                                   (formal-models := (length formal-models))
                                   (pending-oracles := (length pending-oracles))))
              (derived-counts := (.o (blockers := (length blockers-out))
                                     (open-obligations := (length open-obs-out))
                                     (supported-obligations := (length supported-obs-out))
                                     (g2-defects := (length g2-out))
                                     (admitted-formal-models := (length admitted-models-out))))
              (action-authorized? := #f))))
    (.o (admissible? := admissible?)
        (epistemic-status := epistemic-status)
        (action-authorized? := #f)
        (target-repo := target-repo)
        (nasa-profile := nasa-profile)
        (context-digest := context-digest)
        (upstream-polluted := polluted-out)
        (missing-lenses := missing-lens-out)
        (disallowed-engines := disallowed-out)
        (unaddressed-high-findings := unaddressed-out)
        (g2-defects := g2-out)
        (redundant-guard-probes := redundant-probe-out)
        (unresolved-formal-models := unresolved-models-out)
        (vacuous-ephemeral-overlays := vacuous-overlays-out)
        (polluting-ephemeral-overlays := polluting-overlays-out)
        (unclean-formal-proofs := unclean-proofs-out)
        (failed-formal-models := failed-models-out)
        (pending-oracles := pending-oracles-out)
        (admitted-formal-models := admitted-models-out)
        (oracle-disagreement? := oracle-disagreement?)
        (blockers := blockers-out)
        (open-obligations := open-obs-out)
        (supported-obligations := supported-obs-out)
        (next-handoff-mode := next-handoff)
        (formal-library-guidance := formal-library-guidance)
        (funflow-trace := funflow-trace)
        (ascent-directive := (.o (schema := "lambda-aitia.ascent-audit-directive.v1")
                                 (engine-binding := "native-ai-environment")
                                 (target-repo := target-repo)
                                 (nasa-profile := nasa-profile)
                                 (context-digest := context-digest)
                                 (open-obligations := open-obs-out)
                                 (missing-lenses := missing-lens-out)
                                 (unaddressed-high-findings := unaddressed-out)
                                 (g2-defects := g2-out)
                                 (vacuous-ephemeral-overlays := vacuous-overlays-out)
                                 (pending-oracles := pending-oracles-out)
                                 (formal-library-guidance := formal-library-guidance)
                                 (sanctioned-bindings := +sanctioned-ai-engines+)
                                 (action-authorized? := #f)))
        (marlin-handoff := (.o (schema := "lambda-aitia.marlin-audit-handoff.v1")
                               (engine-binding := "marlin-agent-core")
                               (boundary := "marlin-agent-core")
                               (capability := "marlin.agent.audit-detached-diff")
                               (target-repo := target-repo)
                               (context-digest := context-digest)
                               (open-obligations := open-obs-out)
                               (missing-lenses := missing-lens-out)
                               (unaddressed-high-findings := unaddressed-out)
                               (g2-defects := g2-out)
                               (vacuous-ephemeral-overlays := vacuous-overlays-out)
                               (pending-oracles := pending-oracles-out)
                               (formal-library-guidance := formal-library-guidance)
                               (action-authorized? := #f))))))

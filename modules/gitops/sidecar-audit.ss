;;; RFC 0022: Native Scheme/POO gerbil-ascent engine for Detached Sidecar AI Audit
;;; obligation derivation, dual-mode sanctioned AI engine directives
;;; (`native-ai-environment` ASCENT directive + `marlin-agent-core` handoff),
;;; and NASA NPR 7150.2D (`SWE-083`, `SWE-084`, `SWE-087`, `SWE-146`) admission.
;;; Never grants execution authority (`action-authorized?: #f`).

(import (only-in :clan/poo/object .o .get .ref .slot? object?)
        (only-in :gerbil/core string-prefix?)
        (only-in :std/list/list append-map delete-duplicates/hash filter-map)
        (only-in :gerbil-ascent/program/api
                 relational-fragment relational-export relational-compose
                 relational-open-session relational-session-prepare-transaction
                 relational-prepare-queries))
(export gitops-sidecar-audit-assess)

(def +sanctioned-ai-engines+ '("native-ai-environment" "marlin-agent-core"))
(def +nasa-sidecar-obligations+ '("SWE-083" "SWE-084" "SWE-087" "SWE-146"))

(def +sidecar-audit-engine-mutex+ (make-mutex 'sidecar-audit-engine))
(def +sidecar-audit-engine-cell+ (box #f))

(def (opt-slot obj key default)
  (if (and (object? obj) (.slot? obj key))
    (.ref obj key)
    default))

(def (make-sidecar-audit-engine)
  (let* ((intake-frag
          (relational-fragment
           (import)
           (source (required_lens (lens) '() (role input))
                   (covered_lens (lens) '() (role input))
                   (polluted_path (path) '() (role input))
                   (report_engine (report_id engine) '() (role input))
                   (allowed_engine (engine) '() (role input)))
           (private (missing_lens (lens))
                    (disallowed_engine (report_id engine)))
           (export (required_lens required_lens)
                   (covered_lens covered_lens)
                   (polluted_path polluted_path)
                   (report_engine report_engine)
                   (allowed_engine allowed_engine)
                   (missing_lens missing_lens)
                   (disallowed_engine disallowed_engine))
           (rule (missing_lens ?l)
                 (required_lens ?l)
                 (not (covered_lens ?l)))
           (rule (disallowed_engine ?r ?e)
                 (report_engine ?r ?e)
                 (not (allowed_engine ?e)))))
         (review-frag
          (relational-fragment
           (import)
           (source (high_finding (finding_id) '() (role input))
                   (addressed_finding (finding_id) '() (role input))
                   (stale_report (report_id) '() (role input))
                   (missing_provenance (report_id) '() (role input))
                   (fact_flag (name) '() (role input))
                   (required_flag (name) '() (role input)))
           (private (unaddressed_high (finding_id))
                    (missing_flag (name)))
           (export (high_finding high_finding)
                   (addressed_finding addressed_finding)
                   (stale_report stale_report)
                   (missing_provenance missing_provenance)
                   (fact_flag fact_flag)
                   (required_flag required_flag)
                   (unaddressed_high unaddressed_high)
                   (missing_flag missing_flag))
           (rule (unaddressed_high ?f)
                 (high_finding ?f)
                 (not (addressed_finding ?f)))
           (rule (missing_flag ?n)
                 (required_flag ?n)
                 (not (fact_flag ?n)))))
         (obligation-frag
          (relational-fragment
           (import (polluted_path (relational-export intake-frag 'polluted_path))
                   (missing_lens (relational-export intake-frag 'missing_lens))
                   (disallowed_engine (relational-export intake-frag 'disallowed_engine))
                   (unaddressed_high (relational-export review-frag 'unaddressed_high))
                   (stale_report (relational-export review-frag 'stale_report))
                   (missing_provenance (relational-export review-frag 'missing_provenance))
                   (missing_flag (relational-export review-frag 'missing_flag)))
           (source (obligation (id) '() (role input))
                   (swe084_tag (id) '() (role input))
                   (swe087_tag (id) '() (role input))
                   (swe146_tag (id) '() (role input))
                   (human_flag_tag (name) '() (role input))
                   (conv_flag_tag (name) '() (role input)))
           (private (blocker (reason))
                    (open_obligation (id))
                    (supported_obligation (id)))
           (export (obligation obligation)
                   (swe084_tag swe084_tag)
                   (swe087_tag swe087_tag)
                   (swe146_tag swe146_tag)
                   (human_flag_tag human_flag_tag)
                   (conv_flag_tag conv_flag_tag)
                   (blocker blocker)
                   (open_obligation open_obligation)
                   (supported_obligation supported_obligation))
           (rule (blocker (value 'upstream-pollution))
                 (polluted_path ?_))
           (rule (blocker (value 'missing-audit-lens))
                 (missing_lens ?_))
           (rule (blocker (value 'unsanctioned-engine-binding))
                 (disallowed_engine ?_ ?_))
           (rule (blocker (value 'unaddressed-high-finding))
                 (unaddressed_high ?_))
           (rule (blocker (value 'stale-ai-audit))
                 (stale_report ?_))
           (rule (blocker (value 'missing-swe146-provenance))
                 (missing_provenance ?_))
           (rule (blocker (value 'missing-conversation-binding))
                 (missing_flag ?f)
                 (conv_flag_tag ?f))
           (rule (blocker (value 'missing-human-approval))
                 (missing_flag ?f)
                 (human_flag_tag ?f))
           (rule (open_obligation ?o)
                 (swe084_tag ?o)
                 (polluted_path ?_))
           (rule (open_obligation ?o)
                 (swe087_tag ?o)
                 (unaddressed_high ?_))
           (rule (open_obligation ?o)
                 (swe087_tag ?o)
                 (missing_flag ?f)
                 (human_flag_tag ?f))
           (rule (open_obligation ?o)
                 (swe146_tag ?o)
                 (missing_lens ?_))
           (rule (open_obligation ?o)
                 (swe146_tag ?o)
                 (disallowed_engine ?_ ?_))
           (rule (open_obligation ?o)
                 (swe146_tag ?o)
                 (stale_report ?_))
           (rule (open_obligation ?o)
                 (swe146_tag ?o)
                 (missing_provenance ?_))
           (rule (open_obligation ?o)
                 (swe146_tag ?o)
                 (missing_flag ?f)
                 (conv_flag_tag ?f))
           (rule (supported_obligation ?o)
                 (obligation ?o)
                 (not (open_obligation ?o)))))
         (composed (relational-compose (list intake-frag review-frag obligation-frag) 4096 16384 16384))
         (session (relational-open-session composed))
         (run-tx
          (relational-session-prepare-transaction
           session
           (list (list intake-frag 'required_lens)
                 (list intake-frag 'covered_lens)
                 (list intake-frag 'polluted_path)
                 (list intake-frag 'report_engine)
                 (list intake-frag 'allowed_engine)
                 (list review-frag 'high_finding)
                 (list review-frag 'addressed_finding)
                 (list review-frag 'stale_report)
                 (list review-frag 'missing_provenance)
                 (list review-frag 'fact_flag)
                 (list review-frag 'required_flag)
                 (list obligation-frag 'obligation)
                 (list obligation-frag 'swe084_tag)
                 (list obligation-frag 'swe087_tag)
                 (list obligation-frag 'swe146_tag)
                 (list obligation-frag 'human_flag_tag)
                 (list obligation-frag 'conv_flag_tag))))
         (read-intake
          (relational-prepare-queries intake-frag '(polluted_path missing_lens disallowed_engine)))
         (read-review
          (relational-prepare-queries review-frag '(unaddressed_high)))
         (read-obligation
          (relational-prepare-queries obligation-frag '(blocker open_obligation supported_obligation))))
    (.o (run-tx := run-tx)
        (read-intake := read-intake)
        (read-review := read-review)
        (read-obligation := read-obligation))))

(def (sidecar-audit-engine!)
  (or (unbox +sidecar-audit-engine-cell+)
      (let ((engine (make-sidecar-audit-engine)))
        (set-box! +sidecar-audit-engine-cell+ engine)
        engine)))

(def (non-empty-string? x)
  (and (string? x) (> (string-length x) 0)))

(def (sha256-digest? x)
  (and (string? x) (string-prefix? "sha256:" x) (> (string-length x) 7)))

(def (polluted-path? path forbidden-prefixes)
  (and (string? path)
       (ormap (lambda (prefix) (string-prefix? prefix path)) forbidden-prefixes)))

;;; Pure POO entry point for Scheme/ASCENT detached sidecar audit derivation.
;;; `input` is a POO object carrying:
;;;   target-repo, nasa-profile, context-digest, changed-paths, forbidden-prefixes,
;;;   required-lenses, ai-reports, conversation-bound?, human-approved?, dispositions.
(def (gitops-sidecar-audit-assess input)
  (let* ((target-repo (opt-slot input 'target-repo "unknown-repo"))
         (nasa-profile (opt-slot input 'nasa-profile "nasa/sdlc/npr-7150.2d"))
         (context-digest (opt-slot input 'context-digest ""))
         (changed-paths (opt-slot input 'changed-paths '()))
         (forbidden-prefixes (opt-slot input 'forbidden-prefixes '(".agents/aita/" ".aitia/")))
         (required-lenses (delete-duplicates/hash (opt-slot input 'required-lenses '())))
         (ai-reports (opt-slot input 'ai-reports '()))
         (conversation-bound? (and (opt-slot input 'conversation-bound? #f) #t))
         (human-approved? (and (opt-slot input 'human-approved? #f) #t))
         (dispositions (opt-slot input 'dispositions '()))
         (polluted-paths
          (filter (lambda (p) (polluted-path? p forbidden-prefixes)) changed-paths))
         (report-entries
          (map (lambda (rep idx)
                 (let* ((rid (string-append "report-" (number->string idx)))
                        (engine (opt-slot rep 'engine-binding ""))
                        (lens (opt-slot rep 'lens ""))
                        (rep-ctx (opt-slot rep 'context-digest ""))
                        (epistemic (opt-slot rep 'epistemic-status ""))
                        (auth? (opt-slot rep 'action-authorized? #t))
                        (prov-ok?
                         (and (non-empty-string? (opt-slot rep 'provider ""))
                              (non-empty-string? (opt-slot rep 'model-id ""))
                              (sha256-digest? (opt-slot rep 'prompt-template-digest ""))
                              (equal? epistemic "hypothesized")
                              (not auth?)))
                        (stale? (not (equal? rep-ctx context-digest)))
                        (high-ids
                         (filter-map
                          (lambda (f)
                            (let ((sev (opt-slot f 'severity ""))
                                  (fid (opt-slot f 'id "")))
                              (and (or (equal? sev "critical") (equal? sev "high"))
                                   (non-empty-string? fid)
                                   fid)))
                          (opt-slot rep 'findings '()))))
                   (.o (rid := rid) (engine := engine) (lens := lens)
                       (prov-ok? := prov-ok?) (stale? := stale?) (high-ids := high-ids))))
               ai-reports (iota (length ai-reports))))
         (covered-lenses
          (delete-duplicates/hash
           (filter-map (lambda (e)
                         (and (non-empty-string? (.get e lens))
                              (member (.get e engine) +sanctioned-ai-engines+)
                              (not (.get e stale?))
                              (.get e prov-ok?)
                              (.get e lens)))
                       report-entries)))
         (report-engine-rows
          (map (lambda (e) (list (.get e rid) (.get e engine))) report-entries))
         (stale-rows
          (filter-map (lambda (e) (and (.get e stale?) (list (.get e rid)))) report-entries))
         (missing-prov-rows
          (filter-map (lambda (e) (and (not (.get e prov-ok?)) (list (.get e rid)))) report-entries))
         (high-finding-rows
          (map list (delete-duplicates/hash (append-map (lambda (e) (.get e high-ids)) report-entries))))
         (addressed-rows
          (map list
               (delete-duplicates/hash
                (filter-map
                 (lambda (d)
                   (let ((fid (opt-slot d 'finding-id ""))
                         (status (opt-slot d 'status ""))
                         (rationale (opt-slot d 'rationale "")))
                     (and (non-empty-string? fid)
                          (or (equal? status "fixed-verified")
                              (equal? status "waived-with-rationale"))
                          (non-empty-string? rationale)
                          fid)))
                 dispositions))))
         (fact-flag-rows
          (append (if conversation-bound? '(("conversation-bound")) '())
                  (if human-approved? '(("human-approved")) '())))
         (val->id (make-hash-table))
         (id->val (make-hash-table))
         (next-id 1)
         (intern! (lambda (v)
                    (or (hash-get val->id v)
                        (let ((id next-id))
                          (set! next-id (+ next-id 1))
                          (hash-put! val->id v id)
                          (hash-put! id->val id v)
                          id))))
         (decode (lambda (id) (hash-ref id->val id)))
         (intern-rows (lambda (rows) (map (lambda (row) (map intern! row)) rows)))
         (tx-batches
          (list (intern-rows (map list required-lenses))
                (intern-rows (map list covered-lenses))
                (intern-rows (map list polluted-paths))
                (intern-rows report-engine-rows)
                (intern-rows (map list +sanctioned-ai-engines+))
                (intern-rows high-finding-rows)
                (intern-rows addressed-rows)
                (intern-rows stale-rows)
                (intern-rows missing-prov-rows)
                (intern-rows fact-flag-rows)
                (intern-rows '(("conversation-bound") ("human-approved")))
                (intern-rows (map list +nasa-sidecar-obligations+))
                (intern-rows '(("SWE-084")))
                (intern-rows '(("SWE-087")))
                (intern-rows '(("SWE-146")))
                (intern-rows '(("human-approved")))
                (intern-rows '(("conversation-bound")))))
         (query-results
          (dynamic-wind
            (lambda () (mutex-lock! +sidecar-audit-engine-mutex+))
            (lambda ()
              (let* ((eng (sidecar-audit-engine!))
                     (solution ((.get eng run-tx) tx-batches)))
                (list ((.get eng read-intake) solution)
                      ((.get eng read-review) solution)
                      ((.get eng read-obligation) solution))))
            (lambda () (mutex-unlock! +sidecar-audit-engine-mutex+))))
         (intake-out (car query-results))
         (review-out (cadr query-results))
         (ob-out (caddr query-results))
         (polluted-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref intake-out 0))))
         (missing-lens-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref intake-out 1))))
         (disallowed-out (map (lambda (r) (list (decode (car r)) (decode (cadr r)))) (list-ref intake-out 2)))
         (unaddressed-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref review-out 0))))
         (blockers-out (list-sort string<? (map (lambda (r) (symbol->string (car r))) (list-ref ob-out 0))))
         (open-obs-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref ob-out 1))))
         (supported-obs-out (list-sort string<? (map (lambda (r) (decode (car r))) (list-ref ob-out 2))))
         (admissible? (null? blockers-out))
         (next-handoff
          (cond
           (admissible? "ready-for-sidecar-commit")
           ((pair? polluted-out) "clean-upstream-pollution")
           ((or (pair? missing-lens-out) (pair? disallowed-out) (pair? stale-rows) (pair? missing-prov-rows))
            "dispatch-ai-audit-lenses")
           (else "human-independent-review"))))
    (.o (admissible? := admissible?)
        (action-authorized? := #f)
        (target-repo := target-repo)
        (nasa-profile := nasa-profile)
        (context-digest := context-digest)
        (upstream-polluted := polluted-out)
        (missing-lenses := missing-lens-out)
        (disallowed-engines := disallowed-out)
        (unaddressed-high-findings := unaddressed-out)
        (blockers := blockers-out)
        (open-obligations := open-obs-out)
        (supported-obligations := supported-obs-out)
        (next-handoff-mode := next-handoff)
        (ascent-directive := (.o (schema := "lambda-aitia.ascent-audit-directive.v1")
                                 (engine-binding := "native-ai-environment")
                                 (target-repo := target-repo)
                                 (nasa-profile := nasa-profile)
                                 (context-digest := context-digest)
                                 (open-obligations := open-obs-out)
                                 (missing-lenses := missing-lens-out)
                                 (unaddressed-high-findings := unaddressed-out)
                                 (sanctioned-bindings := +sanctioned-ai-engines+)
                                 (action-authorized? := #f)))
        (marlin-handoff := (.o (schema := "lambda-aitia.marlin-audit-handoff.v1")
                               (engine-binding := "marlin-agent-core")
                               (boundary := "marlin-agent-core")
                               (capability := "marlin.agent.audit-detached-diff")
                               (target-repo := target-repo)
                               (context-digest := context-digest)
                               (open-obligations := open-obs-out)
                               (missing-lenses := missing-lens-out)
                               (unaddressed-high-findings := unaddressed-out)
                               (action-authorized? := #f))))))

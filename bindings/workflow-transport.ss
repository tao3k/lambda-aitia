;;; JSON/POO transport for Lambda Aitia's RFC 0008 native ASCENT Obligation
;;; Graph + FunFlow CAS DAG reconciler (`modules/workflow`).
;;; Projects admitted POO frontier facts into a single wire envelope for Rust
;;; `AitiaSession`, CLI (`aitia flow`), and Python consumers.

(import (only-in :std/encoding/json json->string)
        (only-in :clan/poo/object .get .o .ref .slot? object?)
        (only-in "../init.ss" lambda-aitia.init.exports)
        "transport-common.ss")

(export aitia-workflow-reconcile-payload
        aitia-workflow-protocol-step-payload)

(def (optional-workflow-list input field)
  (let ((rows (or (hash-get input field) '())))
    (if (vector? rows) (vector->list rows) rows)))

(def (json-workflow-scope row)
  (.o name: (json-required row "name")
      paths: (json-list row "paths")))

(def (json-workflow-naming input (extra-scopes '()))
  (.o project-key: (json-required input "projectKey")
      primary-language: (hash-get input "primaryLanguage")
      language-sources: (json-list input "languageSources")
      types: (json-list input "types")
      scopes: (append (map json-workflow-scope (optional-workflow-list input "scopes"))
                      extra-scopes)
      references: (map (lambda (row)
                         (.o identity: (json-required row "identity")
                             source: (json-required row "source")
                             element: (json-required row "element")))
                       (json-list input "references"))))

(def (json-workflow-sources input cut)
  (map (lambda (row)
         (.o path: (json-required row "path")
             text: (json-required row "text")
             (cut := cut)))
       (json-list input "sources")))

(def (json-workflow-proposals input)
  (let ((rows (or (hash-get input "proposals") '())))
    (map (lambda (row)
           (.o identity: (json-required row "identity")
               reference: (json-required row "reference")
               language: (json-required row "language")
               language-source: (json-required row "languageSource")
               type: (json-required row "type")
               scope: (json-required row "scope")
               summary: (json-required row "summary")
               rationale: (json-required row "rationale")))
         (if (vector? rows) (vector->list rows) rows))))

(def (json-workflow-observations input cut)
  (let ((rows (or (hash-get input "observations") '())))
    (map (lambda (row)
           (.o (cut := cut)
               identity: (json-required row "identity")
               obligation: (json-required row "obligation")
               outcome: (json-symbol row "outcome")))
         (if (vector? rows) (vector->list rows) rows))))

(def (json-workflow-proposal wf raw)
  (let ((kind (json-required raw "kind")))
    (cond
     ((equal? kind "raw-single-step-tool-call")
      ((.get wf raw-tool-call)
       (string->symbol (json-required raw "toolName"))
       (json-list raw "args")))
     ((equal? kind "bounded-competing-branches")
      ((.get wf competing-branches)
       (map (lambda (row)
              (.o (branch-id := (string->symbol (json-required row "branchId")))
                  (description := (or (hash-get row "description") ""))
                  (supports-hypotheses := (let ((v (or (hash-get row "supportsHypotheses") '())))
                                            (if (vector? v) (vector->list v) v)))
                  (contradicts-hypotheses := (let ((v (or (hash-get row "contradictsHypotheses") '())))
                                               (if (vector? v) (vector->list v) v)))
                  (open-questions := (let ((v (or (hash-get row "openQuestions") '())))
                                       (if (vector? v) (vector->list v) v)))))
            (json-list raw "branches"))))
     (else
      (error "unsupported workflow oracle proposal kind" kind)))))

(def (obligation->json ob)
  (hash (id (.ref ob 'obligation-id))
        (title (.ref ob 'title))
        (requiredEvidence (list->vector (.ref ob 'required-evidence-ids)))
        (dependsOn (list->vector (.ref ob 'depends-on)))
        (activeDefeaters (symbols->json (.ref ob 'active-defeaters)))))

(def (hole->json hole)
  (hash (id (.ref hole 'hole-id))
        (obligation (.ref hole 'obligation-id))
        (description (.ref hole 'description))
        (maxBranches (.ref hole 'max-branches))))

(def (hypothesis->json hyp)
  (hash (id (.ref hyp 'hypothesis-id))
        (claim (.ref hyp 'claim))
        (openQuestions (list->vector
                        (map (lambda (q)
                               (if (string? q) q (call-with-output-string (lambda (p) (write q p)))))
                             (.ref hyp 'open-questions))))))

(def (scalar->json value)
  (cond
   ((symbol? value) (symbol->string value))
   ((or (string? value) (number? value) (boolean? value)) value)
   (else (call-with-output-string (lambda (p) (write value p))))))

(def (provenance-step->json step)
  (let ((kind (car step))
        (assignment (cadr step))
        (supports (caddr step)))
    (hash (kind (symbol->string kind))
          (relation (symbol->string (car assignment)))
          (args (list->vector (map scalar->json (cdr assignment))))
          (supports
           (list->vector
            (map (lambda (sup)
                   (let ((ordinal (list-ref sup 0))
                         (head-kind (list-ref sup 1))
                         (premises (list-ref sup 3))
                         (offered (list-ref sup 4)))
                     (hash (ordinal ordinal)
                           (headKind (symbol->string head-kind))
                           (premises
                            (list->vector
                             (map (lambda (p) (list->vector (map scalar->json p)))
                                  premises)))
                           (offered (list->vector (map scalar->json offered))))))
                 supports))))))

(def (choice-world->json world)
  (let ((sdec (.get world scope-decision))
        (ddec (.get world dispatch-decision))
        (skind (.get world scope-derivation-kind))
        (dkind (.get world dispatch-derivation-kind)))
    (hash (worldIndex (.get world world-index))
          (scopeDecision (and sdec (symbol->string sdec)))
          (dispatchDecision (and ddec (symbol->string ddec)))
          (scopeDerivationKind (and skind (symbol->string skind)))
          (dispatchDerivationKind (and dkind (symbol->string dkind)))
          (scopeProvenance
           (list->vector (map provenance-step->json (.get world scope-provenance))))
          (dispatchProvenance
           (list->vector (map provenance-step->json (.get world dispatch-provenance))))
          (actionAuthorized #f))))

(def (branch-matrix->json matrix)
  (and matrix
       (hash (kind (symbol->string (.ref matrix 'kind)))
             (branchCount (.ref matrix 'branch-count))
             (hypothesisCount (.ref matrix 'hypothesis-count))
             (actionAuthorized #f)
             (rows
              (list->vector
               (map (lambda (row)
                      (hash (branchId (symbol->string (.ref row 'branch-id)))
                            (description (.ref row 'description))
                            (actionAuthorized #f)
                            (hypothesisAssessments
                             (list->vector
                              (map (lambda (a)
                                     (hash (hypothesisId (.ref a 'hypothesis-id))
                                           (relation (symbol->string (.ref a 'relation)))
                                           (activeDefeaters (symbols->json (.ref a 'active-defeaters)))))
                                   (.ref row 'hypothesis-assessments))))))
                    (.ref matrix 'rows)))))))

(def (json-workflow-checks input)
  (let ((rows (optional-workflow-list input "checks")))
    (and (pair? rows)
         (map (lambda (row)
                (list (json-required row "requirement")
                      (json-required row "method")))
              rows))))

(def (repair-task->json task)
  (hash (kind (symbol->string (.get task kind)))
        (holeId (.get task hole-id))
        (obligationId (.get task obligation-id))
        (gapKind (symbol->string (.get task gap-kind)))
        (target (symbol->string (.get task target)))
        (repairRound (.get task repair-round))
        (recomputeScope (symbol->string (.get task recompute-scope)))
        (decayedObligations (list->vector (.get task decayed-obligations)))
        (preservedSupportedObligations
         (list->vector (.get task preserved-supported-obligations)))
        (unscopedPaths (list->vector (.get task unscoped-paths)))
        (openDiagnostics
         (list->vector
          (map (lambda (row) (list->vector (map scalar->json row)))
               (.get task open-diagnostics))))
        (allowedScopes (list->vector (.get task allowed-scopes)))
        (allowedReferences (list->vector (.get task allowed-references)))
        (allowedTypes (list->vector (.get task allowed-types)))
        (maxBranches (.get task max-branches))
        (actionAuthorized #f)))

(def (epistemic-summary->json summary)
  (and summary
       (hash (profile (.get summary profile))
             (choiceStatus (symbol->string (.get summary choice-status)))
             (worldCount (.get summary world-count))
             (supportedCount (.get summary supported-count))
             (staleCount (.get summary stale-count))
             (openCount (.get summary open-count))
             (reopenedCount (.get summary reopened-count))
             (decayedObligations (list->vector (.get summary decayed-obligations)))
             (staleEvidenceIds (list->vector (.get summary stale-evidence-ids)))
             (evidenceDecayDetected (.get summary evidence-decay-detected?)))))

(def (reconcile-result->hash project cut graph initial report final-frontier proposal-res)
  (let* ((initial-plan (.get initial funflow-plan))
         (initial-batch (if (and initial-plan (.ref initial-plan 'valid?))
                          (map (lambda (t) (.ref t 'task-id)) (.ref initial-plan 'parallel-batch))
                          '()))
         (subagents (if initial-plan (.ref initial-plan 'subagents-spawned) 0))
         (semantics (and (.slot? graph 'semantics-assessment)
                         (.ref graph 'semantics-assessment)))
         (choice-sol (.get graph choice-solution)))
    (hash (schema "lambda-aitia.workflow-reconcile.v1")
          (project project)
          (profile (if (.slot? graph 'profile) (.ref graph 'profile) "lambda-aitia/sdlc"))
          (commit (if cut (.get cut commit) (if (.slot? graph 'change-id) (.ref graph 'change-id) "")))
          (choiceStatus (symbol->string (.get choice-sol choice-status)))
          (choiceWorldCount (.get choice-sol world-count))
          (choiceWorlds
           (list->vector (map choice-world->json (.get choice-sol worlds))))
          (initialFrontierMode (symbol->string (.get initial frontier-mode)))
          (initialParallelBatch (list->vector initial-batch))
          (subagentsSpawned subagents)
          (frontierMode (symbol->string (.ref final-frontier 'frontier-mode)))
          (quiescent (if report (.ref report 'quiescent?) (.get initial quiescent?)))
          (totalLlmCalls (if report (.ref report 'total-llm-calls) 0))
          (totalDetTasks (if report (.ref report 'total-det-tasks) 0))
          (dischargedObligations
           (list->vector (map obligation->json (.ref final-frontier 'discharged-obligations))))
          (unsatisfiedObligations
           (list->vector (map obligation->json (.ref final-frontier 'unsatisfied-obligations))))
          (blockedOnHumanObligations
           (list->vector (map obligation->json (.ref final-frontier 'blocked-on-human-obligations))))
          (readySynthesisHoles
           (list->vector (map hole->json (.ref final-frontier 'ready-synthesis-holes))))
          (unrefutedHypotheses
           (list->vector (map hypothesis->json (.ref final-frontier 'unrefuted-hypotheses))))
          (epistemicCompetitionStatus
           (symbol->string (.ref final-frontier 'epistemic-competition-status)))
          (unscopedPaths (list->vector (if semantics (.get semantics unscoped-paths) '())))
          (eligibleTitles
           (list->vector
            (if semantics
              (map (lambda (row) (hash (identity (car row)) (title (cadr row))))
                   (.get semantics titles))
              '())))
          (proposalAdmission
           (and proposal-res
                (hash (admitted (.get proposal-res admitted?))
                      (reason (symbol->string (.get proposal-res reason)))
                      (branchMatrix (branch-matrix->json (.get proposal-res branch-matrix)))
                      (actionAuthorized #f))))
          (actionAuthorized #f)
          (releaseAuthorized #f))))

(def (frame-payload->json payload)
  (let ((out (hash)))
    (when (.slot? payload 'directory)
      (hash-put! out 'directory (.ref payload 'directory)))
    (when (.slot? payload 'requested-paths)
      (hash-put! out 'requestedPaths (list->vector (.ref payload 'requested-paths))))
    (when (.slot? payload 'enabled)
      (hash-put! out 'enabled (.ref payload 'enabled)))
    (when (.slot? payload 'commit)
      (hash-put! out 'commit (.ref payload 'commit)))
    (when (.slot? payload 'expected-commit)
      (hash-put! out 'expectedCommit (.ref payload 'expected-commit)))
    (when (.slot? payload 'expected-operation)
      (hash-put! out 'expectedOperation (.ref payload 'expected-operation)))
    (when (.slot? payload 'description)
      (hash-put! out 'description (.ref payload 'description)))
    (when (.slot? payload 'review-context)
      (hash-put! out 'reviewContext (.ref payload 'review-context)))
    (when (.slot? payload 'proposal-binding)
      (hash-put! out 'proposalBinding (.ref payload 'proposal-binding)))
    (when (.slot? payload 'attempt)
      (hash-put! out 'attempt (.ref payload 'attempt)))
    (when (.slot? payload 'remote)
      (hash-put! out 'remote (.ref payload 'remote)))
    (when (.slot? payload 'bookmark)
      (hash-put! out 'bookmark (.ref payload 'bookmark)))
    (when (and (.slot? payload 'expected-remote-head) (.ref payload 'expected-remote-head))
      (hash-put! out 'expectedRemoteHead (.ref payload 'expected-remote-head)))
    (when (.slot? payload 'change-id)
      (hash-put! out 'changeId (.ref payload 'change-id)))
    (when (.slot? payload 'profile)
      (hash-put! out 'profile (.ref payload 'profile)))
    out))

(def (host-frame->json frame)
  (let ((out (hash (capability (.get frame capability))
                   (effectClass (symbol->string (.get frame effect-class)))
                   (receiptKey (.get frame receipt-key))
                   (payload (frame-payload->json (.get frame payload))))))
    (when (and (.slot? frame 'fence-token) (.ref frame 'fence-token))
      (hash-put! out 'fenceToken (.ref frame 'fence-token)))
    out))

(def (json-fenced-commit-spec raw)
  (and (hash-table? raw)
       (.o (expected-commit := (json-required raw "expectedCommit"))
           (expected-operation := (json-required raw "expectedOperation"))
           (description := (json-required raw "description"))
           (review-context := (json-required raw "reviewContext"))
           (proposal-binding := (json-required raw "proposalBinding"))
           (attempt := (hash-get raw "attempt")))))

(def (json-push-target raw)
  (and (hash-table? raw)
       (.o (remote := (json-required raw "remote"))
           (bookmark := (json-required raw "bookmark"))
           (expected-remote-head := (hash-get raw "expectedRemoteHead")))))

(def (aitia-workflow-reconcile-payload payload)
  (assert-aitia-input-budget! payload)
  (let* ((input (read-aitia-json payload))
         (wf (.get lambda-aitia.init.exports modules workflow))
         (project (json-required input "project"))
         (profile (or (hash-get input "profile") "lambda-aitia/sdlc"))
         (required-checks (json-workflow-checks input))
         (cut (replay-cut project (json-required input "cut")))
         (sysml-scopes (map json-workflow-scope (optional-workflow-list input "sysmlScopes")))
         (naming (json-workflow-naming (json-required input "naming") sysml-scopes))
         (sources (json-workflow-sources input cut))
         (paths (json-list input "paths"))
         (proposals (json-workflow-proposals input))
         (observations (json-workflow-observations input cut))
         (approval-live? (and (hash-get input "approvalLive") #t))
         (candidate-offers (optional-workflow-list input "candidateOffers"))
         (forbidden-scopes (optional-workflow-list input "forbiddenScopes"))
         (raw-reconcile (hash-get input "reconcile"))
         (run-reconcile? (if (boolean? raw-reconcile) raw-reconcile #t))
         (graph ((.get wf gitops-commit-graph)
                 naming cut sources paths proposals
                 profile: profile
                 required-checks: required-checks
                 observations: observations
                 approval-live?: approval-live?
                 candidate-offers: candidate-offers
                 forbidden-scopes: forbidden-scopes))
         (initial ((.get wf reconcile-frontier) graph))
         (raw-proposal (hash-get input "proposal"))
         (proposal-res (and raw-proposal
                            ((.get wf admit-proposal)
                             graph
                             (json-workflow-proposal wf raw-proposal))))
         (report (if run-reconcile? ((.get wf reconcile) graph) #f))
         (final-frontier (if report (.ref report 'final-frontier) (.get initial frontier))))
    (json->string
     (reconcile-result->hash project cut graph initial report final-frontier proposal-res))))

(def (aitia-workflow-protocol-step-payload payload)
  (assert-aitia-input-budget! payload)
  (let* ((input (read-aitia-json payload))
         (wf (.get lambda-aitia.init.exports modules workflow))
         (project (json-required input "project"))
         (profile (or (hash-get input "profile") "lambda-aitia/sdlc"))
         (required-checks (json-workflow-checks input))
         (case-id (or (hash-get input "caseId") "aitia/case/gitops-commit"))
         (directory (or (hash-get input "directory") "."))
         (requested-paths (optional-workflow-list input "requestedPaths"))
         (model-check-enabled?
          (if (hash-key? input "modelCheckEnabled")
            (and (hash-get input "modelCheckEnabled") #t)
            #t))
         (include-pr? (and (hash-get input "includePrObservation") #t))
         (raw-receipts (or (hash-get input "receipts") (hash)))
         (jj-receipt (and (hash-table? raw-receipts)
                          (hash-get raw-receipts "gitops.jj.observe-cut")))
         (sysml-raw (and (hash-table? raw-receipts)
                         (hash-get raw-receipts "sysml.project-scopes")))
         (sysml-list (cond
                      ((vector? sysml-raw) (vector->list sysml-raw))
                      ((list? sysml-raw) sysml-raw)
                      (else #f)))
         (pr-receipt (and (hash-table? raw-receipts)
                          (hash-get raw-receipts "gitops.github.observe-pr")))
         (prepare-receipt (and (hash-table? raw-receipts)
                               (hash-get raw-receipts "gitops.jj.prepare-description")))
         (apply-receipt (and (hash-table? raw-receipts)
                             (hash-get raw-receipts "gitops.jj.apply-description")))
         (push-receipt (and (hash-table? raw-receipts)
                            (hash-get raw-receipts "gitops.jj.push-reviewed")))
         (fenced-spec (json-fenced-commit-spec (hash-get input "fencedCommitSpec")))
         (push-target (json-push-target (hash-get input "pushTarget")))
         (repair-round (or (hash-get input "repairRound") 0))
         (max-repair-rounds (or (hash-get input "maxRepairRounds") 3))
         (sdlc-case? (equal? case-id "aitia/case/sdlc-lifecycle"))
         (ready? (and (not sdlc-case?) (hash-table? jj-receipt) (list? sysml-list)))
         (cut (and ready? (replay-cut project (json-required jj-receipt "cut"))))
         (sources (if ready? (json-workflow-sources jj-receipt cut) '()))
         (paths (if ready? (json-list jj-receipt "paths") '()))
         (sysml-scopes (if ready? (map json-workflow-scope sysml-list) '()))
         (naming (and ready? (json-workflow-naming (json-required input "naming") sysml-scopes)))
         (proposals (if ready? (json-workflow-proposals input) '()))
         (observations (if ready? (json-workflow-observations input cut) '()))
         (raw-proposal (hash-get input "proposal"))
         (proposal-obj (and (or ready? sdlc-case?) raw-proposal (json-workflow-proposal wf raw-proposal)))
         (approval-live? (and (hash-get input "approvalLive") #t))
         (candidate-offers (optional-workflow-list input "candidateOffers"))
         (forbidden-scopes (optional-workflow-list input "forbiddenScopes"))
         (run-reconcile?
          (if (hash-key? input "reconcile")
            (and (hash-get input "reconcile") #t)
            #t))
         (ctx
          (if sdlc-case?
            (let ((rt? (if (hash-key? input "requirementsTraced")
                         (and (hash-get input "requirementsTraced") #t)
                         #t))
                  (rc? (if (hash-key? input "retirementClear")
                         (and (hash-get input "retirementClear") #t)
                         #t)))
              (.o (case-id := case-id)
                  (profile := profile)
                  (change-id := (or (hash-get input "changeId") "change:sdlc-default"))
                  (design-alternatives := (let ((alts (optional-workflow-list input "designAlternatives")))
                                            (if (pair? alts) alts '(design-a))))
                  (extra-obligations := (optional-workflow-list input "extraObligations"))
                  (observed-obligations := (optional-workflow-list input "observedObligations"))
                  (requirements-traced? := rt?)
                  (verified? := (and (hash-get input "verified") #t))
                  (retirement-clear? := rc?)
                  (approval-live? := approval-live?)
                  (release-published? := (and (hash-get input "releasePublished") #t))
                  (refuted-designs := (optional-workflow-list input "refutedDesigns"))
                  (required-design := (hash-get input "requiredDesign"))
                  (proposal := proposal-obj)
                  (repair-round := repair-round)
                  (max-repair-rounds := max-repair-rounds)
                  (reconcile? := run-reconcile?)))
            (.o (case-id := case-id)
                (profile := profile)
                (required-checks := required-checks)
                (directory := directory)
                (requested-paths := requested-paths)
                (model-check-enabled? := model-check-enabled?)
                (include-pr-observation? := include-pr?)
                (fenced-commit-spec := fenced-spec)
                (push-target := push-target)
                (repair-round := repair-round)
                (max-repair-rounds := max-repair-rounds)
                (receipts := (.o (jj-observe-cut := jj-receipt)
                                 (sysml-project-scopes := sysml-list)
                                 (github-observe-pr := pr-receipt)
                                 (jj-prepare-description := prepare-receipt)
                                 (jj-apply-description := apply-receipt)
                                 (jj-push-reviewed := push-receipt)))
                (naming := naming)
                (cut := cut)
                (sources := sources)
                (paths := paths)
                (proposals := proposals)
                (observations := observations)
                (proposal := proposal-obj)
                (approval-live? := approval-live?)
                (candidate-offers := candidate-offers)
                (forbidden-scopes := forbidden-scopes)
                (reconcile? := run-reconcile?))))
         (step ((.get wf plan-protocol-step) ctx))
         (cid (.get step case-id))
         (esc (.get step escalation-reason)))
    (json->string
     (hash (schema "lambda-aitia.workflow-protocol-step.v1")
           (profile (.get step profile))
           (state (symbol->string (.get step state)))
           (handoffTarget (symbol->string (.get step handoff-target)))
           (gapKind (symbol->string (.get step gap-kind)))
           (caseId (if (symbol? cid) (symbol->string cid) cid))
           (repairRound (.get step repair-round))
           (maxRepairRounds (.get step max-repair-rounds))
           (escalationReason (if esc (symbol->string esc) (void)))
           (frames (list->vector (map host-frame->json (.get step frames))))
           (repairTasks (list->vector (map repair-task->json (.get step repair-tasks))))
           (epistemicSummary
            (or (epistemic-summary->json (.get step epistemic-summary)) (void)))
           (appliedReceipt (or (.get step applied-receipt) (void)))
           (pushedReceipt (or (.get step pushed-receipt) (void)))
           (reconciliation
            (if (.get step graph)
              (reconcile-result->hash
               project cut
               (.get step graph)
               (.get step initial-frontier)
               (.get step report)
               (.get step final-frontier)
               (.get step proposal-admission))
              (void)))
           (actionAuthorized #f)
           (releaseAuthorized #f)))))
